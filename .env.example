# Скопируйте этот файл в ".env" и впишите свои ключи.
# Файл .env не попадает в git.

# Модель, выбранная при запуске: ollama | gemini | deepseek | claude
DEFAULT_PROFILE=ollama

# --- Локальная модель (Ollama), ключ не нужен ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# --- Gemini: ключ из https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- DeepSeek: ключ из https://platform.deepseek.com ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Claude (платная): ключ из https://platform.claude.com ---
ANTHROPIC_API_KEY=
# claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (чем выше, тем умнее, дольше и дороже)
CLAUDE_EFFORT=medium

# Дополнительные папки, где ассистенту можно работать с файлами (через ;).
# Рабочий стол, Документы и Загрузки разрешены всегда.
ALLOWED_DIRS=
